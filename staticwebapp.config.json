{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin.html",
      "allowedRoles": ["hr"]
    },
    {
      "route": "/admin.html",
      "allowedRoles": ["hr"]
    },
    {
      "route": "/api/reports",
      "methods": ["GET"],
      "allowedRoles": ["hr"]
    },
    {
      "route": "/api/reports/*",
      "methods": ["PATCH"],
      "allowedRoles": ["hr"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/icons/*", "/*.{css,js,json,svg,png,jpg,jpeg,webp}"]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/unauthorized.html",
      "statusCode": 403
    }
  }
}
